# Never commit real credentials.
.env
.credentials.yaml
*.local.yaml
*.bak

# dsh runtime state, when this repo is used as DSH_HOME itself.
profiles/
storages/
logs/
.agent-presets/

.DS_Store

# Vision-toolkit scratch output (crops, previews, traces).
.dsh-vision-toolkit/

# Renders from the 3D proof of concept. Regenerate with
#   node experiments/office-3d-poc/verify.mjs
experiments/office-3d-poc/shot-*.png

# gstack tool state — holds terminal-internal-token, i.e. a credential. It ships its
# own `.gitignore` containing `*`, so this line is defence in depth, not the only guard.
.gstack/
