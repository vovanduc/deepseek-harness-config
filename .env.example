# Credential layer for DeepSeek Harness.
#
# install.sh copies this to ~/.dsh/.env (mode 600) if that file does not exist yet.
# Real values are never committed: .env is gitignored.
#
# Resolution order used by dsh-credentials-local, first hit wins:
#   1. the environment dsh was launched in  (DEEPSEEK_API_KEY=... dsh web)
#   2. ~/.dsh/.credentials.yaml              (written by the web UI's Models page)
#   3. <workspace>/.env                      (per-project override)
#   4. ~/.dsh/.env                           (this file)

# OpenCode Go plan key. Get it from the OpenCode Go dashboard for your account.
# Required by the `opencode-go` provider in settings.yaml.
OPENCODE_GO_API_KEY=sk-replace-me

# Add one line per provider you route later, e.g.:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
