<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DuyetChiPhiCongTac" targetNamespace="http://bpmn.io/schema/bpmn" exporter="dsh" exporterVersion="1.0">
  <bpmn:process id="Process_DuyetChiPhiCongTac" name="Quy trình duyệt chi phí công tác" isExecutable="false">
    <bpmn:startEvent id="StartEvent_DeNghi" name="Nhân viên phát sinh chi phí công tác">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_NopDeNghi" name="Nhân viên nộp đề nghị hoàn ứng">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_04b</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_QuanLyDuyet" name="Quản lý duyệt đề nghị">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_QuanLyDongY" name="Quản lý đồng ý?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ChinhSuaDeNghi" name="Nhân viên chỉnh sửa, bổ sung đề nghị">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_04b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Tren10Trieu" name="Tổng chi phí trên 10 triệu?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_KeToanDuyet" name="Kế toán duyệt đề nghị">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_KeToanDongY" name="Kế toán đồng ý?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_HoanUng" name="Kế toán thực hiện hoàn ứng cho nhân viên">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_HoanUngXong" name="Đã hoàn ứng">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_DeNghi" targetRef="Task_NopDeNghi" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_NopDeNghi" targetRef="Task_QuanLyDuyet" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_QuanLyDuyet" targetRef="Gateway_QuanLyDongY" />
    <bpmn:sequenceFlow id="Flow_04" name="Không" sourceRef="Gateway_QuanLyDongY" targetRef="Task_ChinhSuaDeNghi" />
    <bpmn:sequenceFlow id="Flow_04b" sourceRef="Task_ChinhSuaDeNghi" targetRef="Task_QuanLyDuyet" />
    <bpmn:sequenceFlow id="Flow_05" name="Có" sourceRef="Gateway_QuanLyDongY" targetRef="Gateway_Tren10Trieu" />
    <bpmn:sequenceFlow id="Flow_09" name="Không" sourceRef="Gateway_Tren10Trieu" targetRef="Task_HoanUng" />
    <bpmn:sequenceFlow id="Flow_06" name="Có" sourceRef="Gateway_Tren10Trieu" targetRef="Task_KeToanDuyet" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_KeToanDuyet" targetRef="Gateway_KeToanDongY" />
    <bpmn:sequenceFlow id="Flow_08" name="Có" sourceRef="Gateway_KeToanDongY" targetRef="Task_HoanUng" />
    <bpmn:sequenceFlow id="Flow_10" name="Không" sourceRef="Gateway_KeToanDongY" targetRef="Task_ChinhSuaDeNghi" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_HoanUng" targetRef="EndEvent_HoanUngXong" />
  </bpmn:process>
