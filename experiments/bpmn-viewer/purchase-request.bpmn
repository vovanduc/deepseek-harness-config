    <bpmn:sequenceFlow id="Flow_14" name="Không" sourceRef="Gateway_GiamDocDongY" targetRef="EndEvent_TuChoi" />
    <bpmn:sequenceFlow id="Flow_15" name="Không" sourceRef="Gateway_TruongPhongDongY" targetRef="EndEvent_TuChoi" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_NCCGiaoHang" targetRef="Task_KhoNhanHang" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_KhoNhanHang" targetRef="Task_KiemTraQC" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_KiemTraQC" targetRef="Gateway_DatQC" />
    <bpmn:sequenceFlow id="Flow_19" name="Đạt" sourceRef="Gateway_DatQC" targetRef="Task_NhapKho" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_NhapKho" targetRef="EndEvent_DaNhapKho" />
    <bpmn:sequenceFlow id="Flow_21" name="Không đạt" sourceRef="Gateway_DatQC" targetRef="Task_TraHang" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_TraHang" targetRef="Task_NCCNhanLaiHang" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_NCCNhanLaiHang" targetRef="EndEvent_DaTraHang" />
  </bpmn:process>
