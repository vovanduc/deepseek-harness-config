    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_TruongBoPhan" targetRef="Gateway_MergePheDuyet" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_MergePheDuyet" targetRef="Task_TaoDonPO" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_TaoDonPO" targetRef="Task_NhanHangQC" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NhanHangQC" targetRef="Gateway_DatQC" />
    <bpmn:sequenceFlow id="Flow_11" name="Dat" sourceRef="Gateway_DatQC" targetRef="Task_NhapKho" />
    <bpmn:sequenceFlow id="Flow_12" name="Khong dat" sourceRef="Gateway_DatQC" targetRef="Task_TraHangNCC" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_NhapKho" targetRef="EndEvent_NhapKho" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_TraHangNCC" targetRef="EndEvent_TraHang" />
  </bpmn:process>
